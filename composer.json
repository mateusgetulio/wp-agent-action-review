{
	"name": "mateusgetulio/wp-agent-action-review",
	"description": "Reference consumer of the Agents API approval primitives: agent writes become reviewable, one-time pending actions before they can change WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^7.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"AgentActionReview\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AgentActionReview\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.30"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . \\( -path ./vendor -o -path ./.deps \\) -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"phpstan": "phpstan analyse --no-progress --memory-limit=1G",
		"test": "phpunit",
		"test:integration": "bin/integration-tests.sh",
		"deps": "bin/fetch-deps.sh"
	}
}
